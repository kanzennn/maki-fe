# Build-time configuration. Anything prefixed VITE_ is inlined into the
# bundle and readable by anyone, so never put a secret here.

# The API's base URL, such as https://pos.example.com/api/v1. Empty means
# /api/v1 on the app's own origin: the Vite dev server proxies /api to
# http://localhost:8080, and production serves both from one domain.
VITE_API_BASE_URL=
